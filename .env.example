APP_NAME="Omar Hamidi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa

# --- Database ---
# لوکال:
# DB_URL="mysql://root:password@127.0.0.1:3306/omar_hamidi_ltd"
#
# Aiven (روی Railway این را در Variables ست کنید؛ رمز را URL-encode کنید اگر کاراکتر خاص دارد):
# DB_URL="mysql://avnadmin:PASSWORD@HOST:PORT/DEFADB"
DB_CONNECTION=mysql
DB_URL="mysql://root:password@127.0.0.1:3306/omar_hamidi_ltd"
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_persian_ci

# Aiven معمولاً SSL اجباری دارد
MYSQL_SSL=true
# اختیاری: مسیر CA (اگر خالی باشد از CA سیستم استفاده می‌شود)
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# اگر با verify مشکل داشتید موقتاً false کنید:
MYSQL_SSL_VERIFY=true

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
MAIL_MAILER=log

# --- Railway ---
# این‌ها را در پنل Railway ست کنید (در .env لوکال لازم نیست):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://YOUR-APP.up.railway.app
# APP_KEY=base64:...
# NIXPACKS_PHP_ROOT_DIR=/app/public
# DB_URL=mysql://avnadmin:...@....aivencloud.com:PORT/DB
# MYSQL_SSL=true
